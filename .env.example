# VibeVoice API Konfiguration

# Modell Pfad (HuggingFace oder lokal)
MODEL_PATH=vibevoice/VibeVoice-1.5B
# Alternative: vibevoice/VibeVoice-7B für bessere Qualität

# API Konfiguration
API_HOST=0.0.0.0
API_PORT=8000

# Device (wird automatisch erkannt)
# Mögliche Werte: cuda, mps, cpu
# DEVICE=cpu
